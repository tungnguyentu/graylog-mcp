{
    "mcpServers": {
        "graylog-mcp": {
            "command": "node",
            "args": [
                "/path/to/graylog-mcp/src/index.js"
            ],
            "env": {
                "GRAYLOG_BASE_URL_INSTANCE_1": "http://your-graylog-instance-1.example.com:9000",
                "GRAYLOG_USERNAME_INSTANCE_1": "YOUR_USERNAME_HERE",
                "GRAYLOG_PASSWORD_INSTANCE_1": "YOUR_PASSWORD_HERE",
                "GRAYLOG_LABEL_INSTANCE_1": "production",
                "GRAYLOG_BASE_URL_INSTANCE_2": "http://your-graylog-instance-2.example.com:9000",
                "GRAYLOG_USERNAME_INSTANCE_2": "YOUR_USERNAME_HERE",
                "GRAYLOG_PASSWORD_INSTANCE_2": "YOUR_PASSWORD_HERE",
                "GRAYLOG_LABEL_INSTANCE_2": "staging"
            },
            "_comment": "Add as many instances as needed by incrementing the suffix (INSTANCE_3, INSTANCE_4, ...). Each instance needs BASE_URL plus either API_TOKEN or USERNAME and PASSWORD. If both auth modes exist, API_TOKEN wins. GRAYLOG_LABEL_INSTANCE_N is optional and defaults to instance_N."
        }
    }
}
